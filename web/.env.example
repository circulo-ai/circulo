# SizPay Configuration
SIZPAY_MERCHANT_ID=your_merchant_id
SIZPAY_TERMINAL_ID=your_terminal_id
## Note: username/password must be BASE64 strings of specific byte lengths
## - SIZPAY_USERNAME must decode to 32 bytes (AES-256 key)
## - SIZPAY_PASSWORD must decode to 16 bytes (AES IV)
## Example (Node):
##   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  # for username
##   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"  # for password
SIZPAY_USERNAME=your_username_base64_32_bytes
SIZPAY_PASSWORD=your_password_base64_16_bytes
SIZPAY_SIGN_KEY=your_sign_key