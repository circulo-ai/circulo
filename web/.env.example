# Sizpay Configuration
SIZPAY_BASE_URL=https://ipg.sizpay.ir/api
SIZPAY_MERCHANT_ID=your_merchant_id
SIZPAY_TERMINAL_ID=your_terminal_id
## Note: username/password must be BASE64 strings of specific byte lengths
## - SIZPAY_USERNAME_B64 must decode to 32 bytes (AES-256 key)
## - SIZPAY_PASSWORD_B64 must decode to 16 bytes (AES IV)
## Example (Node):
##   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  # for username
##   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"  # for password
SIZPAY_USERNAME_B64=your_username_base64_32_bytes
SIZPAY_PASSWORD_B64=your_password_base64_16_bytes
SIZPAY_SIGN_KEY=your_sign_key
SIZPAY_RETURN_URL=http://localhost:3000/billing/return
## FX policy configuration (buffer and max slippage during 20-min quote window)
SIZPAY_FX_BUFFER_PCT=0.02
SIZPAY_FX_MAX_SLIPPAGE_PCT=0.05

