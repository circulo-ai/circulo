{
    "name": "@circulo/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "engines": {
        "bun": ">=1.2.13",
        "node": ">=20.0.0"
    },
    "exports": {
        ".": {
            "types": "./index.ts",
            "default": "./index.ts"
        },
        "./schema": {
            "types": "./schema/index.ts",
            "default": "./schema/index.ts"
        },
        "./repositories": {
            "types": "./repositories/index.ts",
            "default": "./repositories/index.ts"
        }
    },
    "scripts": {
        "db:push": "npx drizzle-kit push --config=./drizzle.config.ts",
        "db:migrate": "npx drizzle-kit migrate --config=./drizzle.config.ts",
        "db:studio": "npx drizzle-kit studio --config=./drizzle.config.ts",
        "type-check": "tsc --noEmit"
    },
    "peerDependencies": {
        "drizzle-orm": "^0.44.5",
        "postgres": "^3.4.5"
    },
    "devDependencies": {
        "typescript": "^5.7.3"
    },
    "overrides": {
        "drizzle-orm": "^0.44.5",
        "postgres": "^3.4.5"
    },
    "dependencies": {
        "ai": "5.0.101"
    }
}
