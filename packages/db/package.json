{
  "name": "@circulo-ai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.2.13",
    "node": ">=20.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "default": "./dist/repositories/index.js"
    }
  },
  "scripts": {
    "dev": "bun ./node_modules/typescript/bin/tsc -p tsconfig.json --watch",
    "build": "bun ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "db:generate": "bun ../../node_modules/drizzle-kit/bin.cjs generate --config=./drizzle.config.ts",
    "db:check": "bun ../../node_modules/drizzle-kit/bin.cjs check --config=./drizzle.config.ts",
    "db:push": "bun ../../node_modules/drizzle-kit/bin.cjs push --config=./drizzle.config.ts",
    "db:migrate": "bun ../../node_modules/drizzle-kit/bin.cjs migrate --config=./drizzle.config.ts",
    "db:studio": "bun ../../node_modules/drizzle-kit/bin.cjs studio --config=./drizzle.config.ts",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "dependencies": {
    "@circulo-ai/types": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9"
  }
}
