{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": [
            "ES2020"
        ],
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "jsx": "react",
        "types": [
            "node"
        ]
    },
    "include": [
        "src/core/**/*",
        "src/core/**/*",
        "src/orchestration/**/*",
        "src/plugins/**/*",
        "src/runtime/**/*",
        "src/types/**/*",
        "src/errors/**/*",
        "src/index.ts",
        "src/index.node.ts",
        "src/index.edge.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts"
    ]
}
