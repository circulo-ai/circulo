{
    "name": "@circulo-ai/wf",
    "version": "1.1.0",
    "description": "Production-quality, framework-agnostic TypeScript workflow orchestration runtime with event-sourced execution and strongly-typed DSL",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "release": "pnpm build && npm publish --access public",
        "prepublishOnly": "pnpm build"
    },
    "keywords": [
        "workflow",
        "orchestration",
        "event-sourcing",
        "durable",
        "typescript",
        "state-machine",
        "async",
        "streaming",
        "resumable"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsdown": "^0.17.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.15"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}