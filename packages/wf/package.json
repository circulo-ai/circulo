{
    "name": "@circulo-ai/wf",
    "version": "1.0.0",
    "description": "Production-quality, framework-agnostic TypeScript workflow orchestration runtime with event-sourced execution and strongly-typed DSL",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc",
        "test": "node --loader ts-node/esm tests/basic-workflow.test.ts",
        "test:bun": "bun run tests/basic-workflow.test.ts",
        "test:deno": "deno run --allow-all tests/basic-workflow.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "workflow",
        "orchestration",
        "event-sourcing",
        "durable",
        "typescript",
        "state-machine",
        "async",
        "streaming",
        "resumable"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}