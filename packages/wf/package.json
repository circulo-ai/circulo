{
  "name": "@circulo-ai/wf",
  "version": "2.4.0",
  "description": "Production-quality, framework-agnostic TypeScript workflow orchestration runtime with event-sourced execution and strongly-typed DSL",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "bun ./node_modules/tsdown/dist/run.mjs --watch",
    "build": "bun ./node_modules/tsdown/dist/run.mjs",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "bun ../../node_modules/@biomejs/biome/bin/biome check --formatter-enabled=false --assist-enabled=false --files-ignore-unknown=true src test",
    "test": "bun ./node_modules/vitest/vitest.mjs run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "bun run build && npm publish --access public",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "workflow",
    "orchestration",
    "event-sourcing",
    "durable",
    "typescript",
    "state-machine",
    "async",
    "streaming",
    "resumable"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/circulo-ai/circulo.git"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs",
      "default": "./dist/react.mjs"
    },
    "./definitions": {
      "types": "./dist/definitions.d.mts",
      "import": "./dist/definitions.mjs",
      "default": "./dist/definitions.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.mts",
      "import": "./dist/adapters.mjs",
      "default": "./dist/adapters.mjs"
    },
    "./durable": {
      "types": "./dist/durable.d.mts",
      "import": "./dist/durable.mjs",
      "default": "./dist/durable.mjs"
    },
    "./workers": {
      "types": "./dist/workers.d.mts",
      "import": "./dist/workers.mjs",
      "default": "./dist/workers.mjs"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.mts",
      "import": "./dist/scheduler.mjs",
      "default": "./dist/scheduler.mjs"
    },
    "./security": {
      "types": "./dist/security.d.mts",
      "import": "./dist/security.mjs",
      "default": "./dist/security.mjs"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.mts",
      "import": "./dist/telemetry.mjs",
      "default": "./dist/telemetry.mjs"
    }
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "yaml": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "react": "19.2.0",
    "@types/node": "^20.0.0",
    "tsdown": "^0.17.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
