{
  "name": "@circulo-ai/desktop",
  "version": "0.1.9",
  "private": true,
  "description": "Offline-capable Electron shell for Circulo",
  "homepage": "https://circulo-ai.com",
  "author": {
    "name": "Circulo AI",
    "email": "1839491@gmail.com"
  },
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:web": "node scripts/build-web.cjs",
    "prepare-runtime": "node scripts/prepare-runtime.cjs",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "test": "node --test tests/secrets.test.cjs"
  },
  "build": {
    "appId": "ai.circulo.desktop",
    "productName": "Circulo",
    "asar": true,
    "afterPack": "scripts/verify-runtime.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime-build/server",
        "to": "runtime/server"
      },
      {
        "from": "runtime-build/server/node_modules",
        "to": "runtime/server/node_modules"
      },
      {
        "from": "runtime-build/web",
        "to": "runtime/web"
      },
      {
        "from": "runtime-build/db/migrations",
        "to": "runtime/db/migrations"
      }
    ],
    "win": {
      "icon": "../web/src/app/favicon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Circulo uses your microphone when you start a voice recording in a chat."
      }
    },
    "linux": {
      "executableName": "circulo",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "maintainer": "Circulo AI <1839491@gmail.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9"
  }
}
