{
  "name": "@circulo-ai/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-capable Electron shell for Circulo",
  "main": "src/main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:web": "node scripts/build-web.cjs",
    "prepare-runtime": "node scripts/prepare-runtime.cjs",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "ai.circulo.desktop",
    "productName": "Circulo",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime-build/server",
        "to": "runtime/server"
      },
      {
        "from": "runtime-build/web",
        "to": "runtime/web"
      },
      {
        "from": "runtime-build/db/migrations",
        "to": "runtime/db/migrations"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.com/circulo/"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2"
  }
}
