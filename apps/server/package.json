{
  "name": "server",
  "type": "module",
  "private": true,
  "version": "0.0.2",
  "scripts": {
    "dev": "cd ../.. && cross-env NODE_ENV=development bun --env-file apps/server/.env --watch apps/server/src/index.ts",
    "build": "cross-env NODE_ENV=production bun ./build-server.ts",
    "start": "cross-env NODE_ENV=production bun dist/index.js",
    "typecheck": "bun ./node_modules/typescript/bin/tsc -p tsconfig.typecheck.json --noEmit",
    "test": "bun ./node_modules/vitest/vitest.mjs run --passWithNoTests",
    "db:generate": "bun --env-file=.env ../../node_modules/drizzle-kit/bin.cjs generate --config=../../packages/db/drizzle.config.ts",
    "db:check": "bun --env-file=.env ../../node_modules/drizzle-kit/bin.cjs check --config=../../packages/db/drizzle.config.ts",
    "db:drop": "bun --env-file=.env ../../node_modules/drizzle-kit/bin.cjs drop --config=../../packages/db/drizzle.config.ts",
    "db:migrate": "bun --env-file=.env ../../node_modules/drizzle-kit/bin.cjs migrate --config=../../packages/db/drizzle.config.ts",
    "db:push": "bun --env-file=.env ../../node_modules/drizzle-kit/bin.cjs push --config=../../packages/db/drizzle.config.ts",
    "db:studio": "bun --env-file=.env ../../node_modules/drizzle-kit/bin.cjs studio --config=../../packages/db/drizzle.config.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.39",
    "@ai-sdk/google": "4.0.44",
    "@ai-sdk/openai": "4.0.42",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@azure/communication-email": "^1.1.0",
    "@azure/storage-blob": "^12.34.0",
    "@better-auth/api-key": "1.7.1",
    "@circulo-ai/core": "workspace:^",
    "@circulo-ai/db": "workspace:^",
    "@circulo-ai/di": "workspace:^",
    "@circulo-ai/file-parsers": "workspace:^",
    "@circulo-ai/redis": "workspace:^",
    "@circulo-ai/types": "workspace:*",
    "@circulo-ai/upload": "workspace:^",
    "@circulo-ai/wf": "workspace:*",
    "@e2b/code-interpreter": "^2.9.0",
    "@hono/node-server": "^1.19.17",
    "@hono/standard-validator": "^0.2.3",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.7.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^2.1.1",
    "@scalar/hono-api-reference": "^0.9.48",
    "@swc/core": "^1.16.18",
    "ai": "7.0.66",
    "atmn": "^0.0.28",
    "autumn-js": "^1.5.9",
    "better-auth": "1.7.1",
    "binary-extensions": "^3.2.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.10.2",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "inngest": "^3.54.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "js-yaml": "^4.3.2",
    "jwt-decode": "^4.0.0",
    "mammoth": "^1.13.0",
    "nanoid": "^5.1.16",
    "officeparser": "^7.8.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.34.1",
    "tokenlens": "^1.3.1",
    "uuid": "^13.0.2",
    "vitest": "^4.1.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  }
}
