{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "plugins": [{
      "name": "workflow"
    }],
    "paths": {
      "@/*": ["./src/*"],
      "@/db": ["../../packages/db"],
      "@/db/*": ["../../packages/db/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "**/*.test.ts"]
}
