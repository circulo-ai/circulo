NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3002
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
CIRCULO_DATABASE_DRIVER=postgres
# PGlite local path. Use CIRCULO_DATABASE_DRIVER=pglite for local/desktop mode.
PGLITE_DATA_DIR=.local-storage/pglite
# Optional cloud deployment URL for the desktop/web sync worker.
# NEXT_PUBLIC_CIRCULO_CLOUD_SYNC_URL=https://app.example.com
BETTER_AUTH_URL=http://localhost:3002
BETTER_AUTH_SECRET=super-secret-32-chars-min
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
INTERNAL_API_SECRET=super-secret-32-chars-min
CIRCULO_DEPLOYMENT_MODE=local
CIRCULO_RUNTIME_KIND=desktop
AUTUMN_SECRET_KEY=
BILLING_LOCAL_DEV_PLAN=enterprise
E2B_API_KEY=
NEXT_PUBLIC_BILLING_ENABLED=false
BILLING_ENABLED=false
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379
CRON_SECRET=

# OAuth (enable the ones you use)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPO_CLIENT_ID=
GITHUB_REPO_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
WEALTHBOX_CLIENT_ID=
WEALTHBOX_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Storage: local for development, s3 (default in production), or azure.
CIRCULO_STORAGE_DRIVER=local
CIRCULO_LOCAL_STORAGE_PATH=./.local-storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_NAME=
S3_EXECUTION_FILES_BUCKET_NAME=
S3_KB_BUCKET_NAME=
S3_CHAT_BUCKET_NAME=
S3_PROFILE_PICTURES_BUCKET_NAME=
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_KB_CONTAINER_NAME=
AZURE_STORAGE_EXECUTION_FILES_CONTAINER_NAME=
AZURE_STORAGE_CHAT_CONTAINER_NAME=
AZURE_STORAGE_PROFILE_PICTURES_CONTAINER_NAME=

# Email / notifications
RESEND_API_KEY=
AZURE_ACS_CONNECTION_STRING=
EMAIL_FROM_ADDRESS=noreply@example.com

# AI providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Circulo
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
CIRCULO_VISION_MODEL=openai/gpt-4o-mini
CIRCULO_EMBEDDING_MODEL=openai/text-embedding-3-small
# Comma-separated browser origins allowed to call the API (for additional local/proxy URLs).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated reverse-proxy IPs/CIDRs trusted for forwarded client-IP headers.
# Set this when TRUSTED_PROXY_HOPS is greater than zero in production.
TRUSTED_PROXY_IPS=
# MCP integrations may reference only explicitly provisioned variables in this namespace.
# MCP_CREDENTIAL_GITHUB=replace-me
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=ollama
OLLAMA_URL=http://localhost:11434
# Optional JSON pricing overrides, keyed as provider:model.
# CIRCULO_MODEL_PRICING_JSON={"openai:gpt-4o-mini":{"inputPerMillion":0.15,"outputPerMillion":0.6}}

# Rate limiting defaults
RATE_LIMIT_WINDOW_MS=60000
MANUAL_EXECUTION_LIMIT=999999
RATE_LIMIT_FREE_SYNC=10
RATE_LIMIT_FREE_ASYNC=50
RATE_LIMIT_PRO_SYNC=25
RATE_LIMIT_PRO_ASYNC=200
RATE_LIMIT_TEAM_SYNC=75
RATE_LIMIT_TEAM_ASYNC=500
RATE_LIMIT_ENTERPRISE_SYNC=150
RATE_LIMIT_ENTERPRISE_ASYNC=1000
