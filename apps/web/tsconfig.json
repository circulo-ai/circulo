{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "target": "ESNext",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./public/*"],
      "@/db": ["../../packages/db/index.ts"], // TODO replace with @circulo-ai/db
      "@/db/*": ["../../packages/db/*"], // replace with @circulo-ai/db/*
      "@circulo-ai/db": ["../../packages/db"],
      "@circulo-ai/db/*": ["../../packages/db/*"],
      "@circulo-ai/types": ["../../packages/types/src"],
      "@circulo-ai/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "trigger.config.ts",
    "../server/drizzle.config.ts"
  ],
  "exclude": ["node_modules"]
}
