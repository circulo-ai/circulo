{
  "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "Checkbox",
              "Switch",
              "Input",
              "Textarea",
              "Slider",
              "RadioGroupItem",
              "Select",
              "SelectTrigger",
              "InputOTP"
            ]
          }
        }
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noArguments": "off",
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "performance": {
        "noImgElement": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noControlCharactersInRegex": "off",
        "noExplicitAny": "off",
        "noThenProperty": "off",
        "noShadowRestrictedNames": "off",
        "noAssignInExpressions": "off",
        "noDocumentCookie": "off",
        "noConfusingVoidType": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/components/ui/**",
        "apps/web/src/components/ai-elements/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "recommended": false,
            "noLabelWithoutControl": "off"
          }
        }
      }
    }
  ]
}
