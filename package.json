{
  "name": "circulo-ai",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:stack": "concurrently -k -s first -n db,server,web \"bun --filter @circulo/db dev\" \"bun --filter server dev\" \"bun --filter web dev\"",
    "dev:server": "bun --filter server dev",
    "test": "turbo run test",
    "format": "bun prettier . --write",
    "format:check": "bun prettier . --check",
    "lint": "bun dlx biome check --write --unsafe .",
    "lint:check": "bun dlx biome check --unsafe .",
    "check": "bun dlx biome check --files-ignore-unknown=true",
    "type-check": "turbo run type-check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun build && changeset publish"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next": "15.4.1",
    "@next/env": "15.4.1",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.13.4",
    "@types/fluent-ffmpeg": "2.1.28",
    "drizzle-orm": "^0.44.5",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@circulo-ai/prettier-config": "workspace:*",
    "@next/env": "15.4.1",
    "@tailwindcss/typography": "0.5.19",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.4",
    "lint-staged": "16.0.0",
    "prettier": "3.7.4",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}
