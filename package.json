{
  "name": "circulo-ai",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun ./node_modules/turbo/bin/turbo run build",
    "dev": "bun ./node_modules/turbo/bin/turbo run dev",
    "dev:stack": "bun run build:workspace && bun ./node_modules/concurrently/dist/bin/concurrently.js -k -s first -n db,server,web \"bun --filter @circulo-ai/db dev\" \"bun --filter server dev\" \"bun --filter web dev\"",
    "build:workspace": "turbo run build --filter=server...",
    "desktop:package": "bun run build:workspace && bun --cwd apps/desktop build:web && bun --cwd apps/desktop prepare-runtime && bun --cwd apps/desktop package",
    "desktop:package:dir": "bun run build:workspace && bun --cwd apps/desktop build:web && bun --cwd apps/desktop prepare-runtime && bun --cwd apps/desktop package:dir",
    "dev:server": "bun --filter server dev",
    "db:generate": "bun --env-file=apps/server/.env --filter @circulo-ai/db db:generate",
    "db:check": "bun --env-file=apps/server/.env --filter @circulo-ai/db db:check",
    "db:migrate": "bun --env-file=apps/server/.env --filter @circulo-ai/db db:migrate",
    "test": "bun ./node_modules/turbo/bin/turbo run test",
    "format": "bun ./node_modules/prettier/bin/prettier.cjs . --write",
    "format:check": "bun ./node_modules/prettier/bin/prettier.cjs . --check",
    "lint": "bun ./node_modules/@biomejs/biome/bin/biome check --formatter-enabled=false --assist-enabled=false --files-ignore-unknown=true apps packages",
    "lint:check": "bun ./node_modules/@biomejs/biome/bin/biome check --formatter-enabled=false --assist-enabled=false --files-ignore-unknown=true apps packages",
    "check": "bun ./node_modules/@biomejs/biome/bin/biome check --formatter-enabled=false --assist-enabled=false --files-ignore-unknown=true apps packages",
    "typecheck": "bun ./node_modules/turbo/bin/turbo run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun build && changeset publish"
  },
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "next": "16.4.2",
    "@next/env": "16.4.2",
    "cookie": "^0.7.2",
    "esbuild": "^0.25.0",
    "file-type": "^22.2.0",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "zod": "4.6.7",
    "web>pdfjs-dist": "5.4.296",
    "officeparser>pdfjs-dist": "6.2.108",
    "katex": "^0.18.2",
    "path-to-regexp": "^6.3.0",
    "postcss-selector-parser": "^7.1.6",
    "ws": "^8.21.0",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  },
  "dependencies": {
    "file-type": "^22.2.0",
    "@t3-oss/env-nextjs": "0.13.4",
    "@types/fluent-ffmpeg": "2.1.28",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@circulo-ai/prettier-config": "workspace:*",
    "@next/env": "16.4.2",
    "@tailwindcss/typography": "0.5.19",
    "concurrently": "^9.2.5",
    "drizzle-kit": "0.31.10",
    "lint-staged": "16.0.0",
    "prettier": "3.7.4",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "^2.11.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}
